# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# On Render, set this instead to your actual service domain, e.g.:
# ALLOWED_HOSTS=lifeos-backend-9kqx.onrender.com

# Database (matches a native PostgreSQL install — see README.md)
# On Render, use the Hostname/Port/Database/Username/Password shown on
# your Render Postgres instance's info page instead of the values below.
DB_NAME=lifeos
DB_USER=lifeos
DB_PASSWORD=lifeos_dev_password
DB_HOST=localhost
DB_PORT=5432

# CORS — must be your actual deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# Optional: creates/updates a superuser on every deploy via
# `python manage.py ensure_superuser` — useful on Render's free tier,
# which has no Shell access to run `createsuperuser` interactively.
# Leave blank locally; you already have `createsuperuser` for that.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Google Drive integration (Milestone 18 - leave blank until you create these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/drive/callback/
# On Render, use your service's real callback URL instead, e.g.:
# GOOGLE_OAUTH_REDIRECT_URI=https://lifeos-backend-9kqx.onrender.com/api/integrations/drive/callback/
# (and add that exact URL to the Authorized redirect URIs list in Google Cloud Console)
